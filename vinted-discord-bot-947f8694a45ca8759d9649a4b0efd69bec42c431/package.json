{
  "name": "vinted-discord-bot",
  "version": "2.1.0",
  "main": "index.js",
  "author": "Androz2091 <androz2091@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --inspect index.js",
    "performance": "node --inspect --max-old-space-size=512 index.js",
    "clean": "node -e \"require('fs').rmSync('./db.json', {force:true}); console.log('Database cleaned')\"",
    "optimize": "node optimize.js",
    "profile": "clinic doctor -- node index.js",
    "benchmark": "autocannon -c 10 -d 5 http://localhost:3000"
  },
  "dependencies": {
    "discord-sync-commands": "^0.3.0",
    "discord.js": "^14.14.1",
    "easy-json-database": "^1.5.0",
    "vinted-api": "^2.4.0"
  },
  "devDependencies": {
    "clinic": "^12.1.0",
    "autocannon": "^7.15.0"
  },
  "keywords": ["discord", "bot", "vinted", "notification", "performance"]
}
